; Recovered from the shipped project.binary (ECFG). Field names and values
; are verbatim; the single added line is config_version, which the format
; requires. See docs/146-source-recovery.md.
config_version=5

[animation]
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]
config/name="Graphwar"
config/description="Graphwar is a game of mathematical functions."
config/version="2.0.60"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.054902, 0.145098, 0.109804, 1)
boot_splash/show_image=false
config/icon="res://basic_soldier.png"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/handheld/orientation=4

[editor_plugins]
enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/android_IAPP/plugin.cfg")

[filesystem]
import/blender/enabled=false

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
textures/canvas_textures/default_texture_filter=2
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.054902, 0.145098, 0.109804, 1)

