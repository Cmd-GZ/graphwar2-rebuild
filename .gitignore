target/
Cargo.lock

# 从 Graphwar.pck 解出的游戏资源（二进制衍生，不入库；见 docs/17）
rsc/*
!rsc/MANIFEST.tsv

# 临时分析产物（不应进仓库）
.rea-work/
.sim-work/

# 编译产物：内核库由 cargo build 生成，不进仓库
# 三个桌面平台 + Android 的 ABI 子目录都要挡（docs/132 §4.2 加了 windows/macos/android 条目）
client/*.so
client/*.dll
client/*.dylib
client/android/

# Python 缓存（tools/*.py 会被 import 测试）
__pycache__/
*.pyc

# Godot 4.4+ 为每个脚本生成的 uid 存根（可重生成，不参与构建语义）
client/*.uid
client/src/**/*.uid
client/tools/*.uid

# 参考用原版二进制（Windows/Android 包等）：绝不入库
.reference/
*.apk
*.apks
*.aab
